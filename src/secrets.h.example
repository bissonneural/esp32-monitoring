// Copy this file to src/secrets.h and fill in real values.
// src/secrets.h is git-ignored and must NEVER be committed.
#pragma once

// --- WiFi ---
#define WIFI_SSID "your-network"
#define WIFI_PASSWORD "your-password"

// --- Proxy (Cloud Function) ---
// Full URL of the dashboard endpoint, including scheme and path.
#define PROXY_URL "https://REGION-PROJECT.cloudfunctions.net/gpw-cardputer-proxy/v1/dashboard"

// Bearer token matching the value stored in Secret Manager.
#define PROXY_TOKEN "your-bearer-token"

// --- Development ---
// 1 = skip the network entirely and render a built-in sample payload, so every
// screen can be verified on hardware before the proxy exists. 0 = real HTTP.
#define USE_MOCK_DATA 0
